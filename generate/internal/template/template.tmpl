{{- /*gotype: github.com/go-sphere/protoc-gen-route/generate/internal/template.ServiceDesc*/ -}}
{{$svrType := .ServiceType}}
{{$svrName := .ServiceName}}
{{$optionsKey := .OptionsKey}}
{{$packageDesc := .Package}}
{{$stdContextType := or $packageDesc.StdContextType "context.Context"}}
{{$requestType := $packageDesc.RequestType}}
{{$responseType := $packageDesc.ResponseType}}
{{$extraDataType := $packageDesc.ExtraDataType}}
{{$newExtraDataFunc := $packageDesc.NewExtraDataFunc}}

{{$handlerType := printf "func(ctx %s, request *%s) error" $stdContextType $requestType}}
{{$renderType := printf "func(ctx %s, request *%s, msg *%s) error" $stdContextType $requestType $responseType}}

{{- range .Methods}}
const Operation{{$optionsKey}}{{$svrType}}{{.OriginalName}} = {{goString (printf "/%s/%s" $svrName .OriginalName)}}
{{- end}}

{{- if ne $extraDataType ""}}
{{- range .Methods}}
    {{- if .Extra}}
var Extra{{$optionsKey}}Data{{$svrType}}{{.Name}} = {{$newExtraDataFunc}}(map[string]string{
    {{- range $key, $value := .Extra}}
    {{ goString $key }}: {{ goString $value }},
    {{- end}}
})
    {{- end}}
{{- end}}
{{- end}}

{{- if ne $extraDataType ""}}
func GetExtra{{$optionsKey}}DataBy{{$svrType}}Operation(operation string) *{{$extraDataType}} {
    switch operation {
    {{- range .Methods}}
    {{- if .Extra}}
    case Operation{{$optionsKey}}{{$svrType}}{{.OriginalName}}:
        return Extra{{$optionsKey}}Data{{$svrType}}{{.Name}}
    {{- end}}
    {{- end}}
    default:
        return nil
    }
}
{{- end}}

func GetAll{{$optionsKey}}{{$svrType}}Operations() []string {
    return []string{
    {{- range .Methods}}
    Operation{{$optionsKey}}{{$svrType}}{{.OriginalName}},
    {{- end}}
    }
}

type {{.ServiceType}}{{$optionsKey}}Server interface {
{{- range .Methods}}
	{{- if ne .Comment ""}}
	{{.Comment}}
	{{- end}}
	{{.Name}}({{$stdContextType}}, *{{.Request}}) (*{{.Reply}}, error)
{{- end}}
}

type {{.ServiceType}}{{$optionsKey}}Codec interface {
{{- range .Methods}}
    Decode{{.Name}}Request(ctx {{$stdContextType}}, request *{{$requestType}}) (*{{.Request}}, error)
    Encode{{.Name}}Response(ctx {{$stdContextType}}, response *{{.Reply}}) (*{{$responseType}}, error)
{{- end}}
}

{{range .Methods}}
func _{{$svrType}}_{{.Name}}{{.Num}}_{{$optionsKey}}_Handler(srv {{$svrType}}{{$optionsKey}}Server, codec {{$svrType}}{{$optionsKey}}Codec, render {{$renderType}}) {{$handlerType}} {
    return func(ctx {{$stdContextType}}, request *{{$requestType}}) error {
    		req, err := codec.Decode{{.Name}}Request(ctx, request)
    		if err != nil {
    			return err
    		}
    		resp, err := srv.{{.Name}}(ctx, req)
    		if err != nil {
    			return err
    		}
    		msg, err := codec.Encode{{.Name}}Response(ctx, resp)
    		if err != nil {
    			return err
    		}
    		return render(ctx, request, msg)
    }
}
{{end}}

func Register{{.ServiceType}}{{$optionsKey}}Server(srv {{.ServiceType}}{{$optionsKey}}Server, codec {{.ServiceType}}{{$optionsKey}}Codec, render {{$renderType}}) map[string]{{$handlerType}} {
	handlers := make(map[string]{{$handlerType}})
{{- range .Methods}}
    handlers[Operation{{$optionsKey}}{{$svrType}}{{.OriginalName}}] = _{{$svrType}}_{{.Name}}{{.Num}}_{{$optionsKey}}_Handler(srv, codec, render)
{{- end}}
    return handlers
}
